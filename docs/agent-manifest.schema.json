{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwenaudio.org/schemas/agent-project-v1.json",
  "title": "QwenAudio data-processing Agent project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "name",
    "version",
    "publisher",
    "task",
    "usage",
    "harness",
    "runtime",
    "models",
    "inputs",
    "outputs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 80
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "license": {
      "type": "string"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entry"
      ],
      "properties": {
        "kind": {
          "enum": [
            "native",
            "onnx"
          ]
        },
        "entry": {
          "type": "string",
          "minLength": 1
        },
        "author": {
          "type": "string"
        },
        "package": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        }
      }
    },
    "models": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "files"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^(?:https://.*)?$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "repositoryHosted": {
            "type": "boolean",
            "default": false
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "estimatedSizeMb": {
            "type": "integer",
            "minimum": 1
          },
          "precision": {
            "type": "string"
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source",
                "path",
                "sha256"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-fA-F0-9]{64}$"
                }
              }
            }
          }
        }
      },
      "minItems": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameter"
      }
    },
    "acceleration": {
      "type": "array",
      "items": {
        "enum": [
          "CPU",
          "CUDA",
          "DirectML",
          "CoreML"
        ]
      }
    },
    "tone": {
      "enum": [
        "green",
        "coral",
        "yellow",
        "blue",
        "violet"
      ]
    },
    "featured": {
      "type": "boolean"
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputRequirements",
        "limitations",
        "examples"
      ],
      "properties": {
        "inputRequirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "adapter",
        "capability"
      ],
      "properties": {
        "kind": {
          "const": "host-adapter"
        },
        "adapter": {
          "enum": [
            "kokoro",
            "vits",
            "matcha",
            "kitten",
            "zipvoice",
            "pocket-tts",
            "supertonic",
            "cosyvoice-local",
            "streaming-zipformer",
            "streaming-paraformer",
            "funasr-nano",
            "funasr-sensevoice-gguf",
            "funasr-paraformer-gguf",
            "wenet-ctc",
            "fire-red-asr-ctc",
            "fire-red-asr",
            "moonshine-v2",
            "nemo-parakeet",
            "nemo-canary",
            "qwen3-asr",
            "silero-vad",
            "funasr-fsmn-vad-gguf",
            "dpdfnet2",
            "gtcrn",
            "deepfilternet",
            "rnnoise",
            "zipenhancer",
            "web-audio",
            "audio-tagging",
            "keyword-spotting",
            "language-id",
            "punctuation",
            "wetext",
            "speaker-embedding",
            "speaker-diarization",
            "source-separation",
            "mossformer2-separation"
          ]
        },
        "capability": {
          "enum": [
            "speech.synthesize",
            "speech.transcribe",
            "speech.detect",
            "audio.denoise",
            "audio.enhance",
            "audio.live",
            "audio.classify",
            "speech.keyword",
            "speech.language",
            "text.punctuate",
            "text.normalize",
            "speaker.embed",
            "speaker.diarize",
            "audio.separate"
          ]
        }
      }
    },
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "data-processing-agent"
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "label",
        "pluginId",
        "capability"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "pluginId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "default": {
          "type": "boolean",
          "default": true
        },
        "optional": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "audio",
            "speech-segments",
            "transcript",
            "text",
            "boolean",
            "keyword-events",
            "audio-tags",
            "language",
            "speaker-embedding",
            "speaker-segments",
            "audio-tracks"
          ]
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "batch",
              "stream"
            ]
          },
          "uniqueItems": true
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*$"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean",
            "enum"
          ]
        },
        "description": {
          "type": "string"
        },
        "default": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "multiline": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        }
      }
    }
  }
}
