{
  "$schema": "../../docs/plugin-manifest.schema.json",
  "schemaVersion": 2,
  "id": "org.qwenaudio.toolkits.kokoro-tts",
  "name": "Kokoro TTS 中文",
  "version": "1.1.0",
  "publisher": "QwenAudio Toolkits",
  "description": "通过 sherpa-onnx 在本地运行 Kokoro v1.1 中英文语音合成模型。",
  "license": "Apache-2.0",
  "adapter": "kokoro",
  "capabilities": [
    "speech.tts"
  ],
  "runtime": {
    "kind": "native",
    "entry": "sherpa-onnx",
    "entry": "sherpa-onnx"
  },
  "models": [
    {
      "id": "kokoro-int8-multi-lang-v1_1",
      "source": "https://github.com/k2-fsa/sherpa-onnx/releases/download/tts-models/kokoro-int8-multi-lang-v1_1.tar.bz2",
      "files": [
        "model.int8.onnx",
        "voices.bin",
        "tokens.txt",
        "lexicon-us-en.txt",
        "lexicon-zh.txt",
        "espeak-ng-data"
      ],
      "estimatedSizeMb": 140
    }
  ],
  "acceleration": ["CPU"],
  "featured": true,
  "tone": "coral"
}
